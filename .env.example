# Copy to `.env` and fill in real values locally. Never commit `.env`.
# Every variable is optional; the defaults below keep local development offline.

# SQLite file for all persistent state. Keep it inside a git-ignored directory.
RIB_DATABASE_PATH=data/research_inter_bridge.db

# Directory for uploaded documents and generated artefacts (never committed).
RIB_DATA_DIRECTORY=data

# DEBUG | INFO | WARNING | ERROR | CRITICAL
RIB_LOG_LEVEL=INFO

# Credential redaction is always on and has no setting: it is not optional.

# Default timeout in seconds for outbound HTTP adapters (OpenAlex, Crossref, ...).
RIB_REQUEST_TIMEOUT_SECONDS=15

# Contact address sent in the User-Agent and From header when a live research
# source is fetched. Leave blank to keep live fetching disabled; offline
# browsing and page parsing tests still work. Never put a student's address here.
# RIB_RESEARCH_CONTACT_EMAIL=research@example.org

# --- JSON API (`serve`) ---

# Exact browser origins allowed to call the API, comma separated, no wildcards.
# Empty (the default) trusts no cross-origin caller. For local development with
# `npm run dev` on port 3000, use: http://localhost:3000
# RIB_CORS_ORIGINS=http://localhost:3000

# Set to true whenever the API is served over HTTPS, so the session cookie
# carries the Secure flag.
RIB_COOKIE_SECURE=false

# Name of the HttpOnly session cookie.
RIB_SESSION_COOKIE_NAME=rib_session

# --- Filled in a later phase; placeholders only, no real secrets here ---
# RIB_GOOGLE_OAUTH_CLIENT_ID=<google-oauth-client-id>
# RIB_GOOGLE_OAUTH_CLIENT_SECRET=<google-oauth-client-secret>
# RIB_OAUTH_REDIRECT_URI=<http://localhost:8080/oauth/callback>
